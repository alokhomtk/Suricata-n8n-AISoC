ocal.file_match "suricata_files" {
  path_targets = [
    {
      "__path__" = "/var/log/suricata/eve.json",
      "job"      = "suricata",
    },
  ]
}

loki.source.file "suricata_logs" {
  targets    = local.file_match.suricata_files.targets
  forward_to = [loki.process.suricata_parser.receiver]
}

loki.process "suricata_parser" {
  // Extract JSON entries into map variables
  stage.json {
    expressions = {
      event_type     = "event_type",
      alert_severity = "alert.severity",
      alert_signature= "alert.signature",
      src_ip         = "src_ip",
      dest_ip        = "dest_ip",
    }
  }

  // Turn key fields into searchable Loki indexed labels
  stage.labels {
    values = {
      event_type      = "event_type",
      alert_severity  = "alert_severity",
      alert_signature = "alert_signature",
    }
  }

  forward_to = [loki.write.local_loki.receiver]
}

loki.write "local_loki" {
  endpoint {
    url = "http://localhost:3100/loki/api/v1/push"
  }
}
